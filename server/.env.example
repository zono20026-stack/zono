# Server Port
PORT=5000
NODE_ENV=production

# PostgreSQL Database Configuration
# Option A: Full Connection String (Standard on Render / Supabase / Neon / Railway)
DATABASE_URL=postgresql://username:password@hostname:5432/databasename

# Option B: Individual Parameters (Local development)
DB_HOST=127.0.0.1
DB_PORT=5435
DB_NAME=easy_send_db
DB_USER=postgres
DB_PASSWORD=

# Security & JWT Tokens
JWT_SECRET=zono_super_secret_jwt_key_enterprise_2026_98124
JWT_REFRESH_SECRET=zono_refresh_jwt_key_super_secure_enterprise_88192

# CORS Configuration (Comma-separated allowed origins in production)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
